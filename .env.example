# ─────────────────────────────────────────────────────────────────────────────
# StaffVA Interview app — required environment
#
# Every variable below is READ BY THE CODE. The app previously shipped with no
# .env.example at all, so several of these were undocumented and easy to miss.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Same project as the main platform — the two apps share one database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Interview hand-off token ────────────────────────────────────────────────
# MUST be byte-for-byte identical to SUPABASE_JWT_SECRET on the main platform.
# The platform SIGNS the interview token with that value (jose) and this app
# VERIFIES it with this one (jsonwebtoken). If they differ, every candidate who
# clicks "Start AI Interview" gets "Access Denied — invalid signature".
JWT_INTERVIEW_SECRET=

# ── AI interview pipeline ───────────────────────────────────────────────────
# Read implicitly by the Anthropic SDK (`new Anthropic()` takes no key
# argument), which is why it does not appear in a naive grep for process.env.
# Without it the interviewer falls back to an error turn on every question and
# scoring never runs.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Cross-app links ─────────────────────────────────────────────────────────
# Base URL of the main platform, used in result emails and dashboard links.
NEXT_PUBLIC_STAFFVA_URL=https://staffva.com

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Required by /api/interview/cron/score-pending, which rescues interviews that
# completed but were never scored. This check FAILS CLOSED: if the value is
# unset the cron returns 401 and unscored interviews are never recovered.
CRON_SECRET=

# VERCEL_URL is injected automatically by Vercel — do not set it manually.
